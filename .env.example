# Copy this file for local development. Never commit real credentials.
# For production, set these in the hosting provider's secret/environment store.

# ── Process ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=8788

# Local SQLite fallback, used only when TURSO_DATABASE_URL is empty.
ORDER_DB=.data/orders.db

# ── Hosted database (required when NODE_ENV=production) ────────────────────
# Create a Turso database and token, then paste the libsql:// URL and token.
# https://docs.turso.tech/cloud/migrate-to-turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Public HTTPS origins (required when NODE_ENV=production) ───────────────
# Customer-facing site. Stripe success/cancel URLs are built from this.
PUBLIC_SITE_URL=http://localhost:3000
# Public origin of this API. Defaults to PUBLIC_SITE_URL if omitted.
# The Stripe webhook URL is exactly:
#   ${PUBLIC_API_URL}/api/stripe/webhook
# Example production value: https://api.example.com
PUBLIC_API_URL=http://127.0.0.1:8788
# Comma-separated browser origins allowed to call the API with cookies.
# If omitted, PUBLIC_SITE_URL (plus localhost in development) is used.
ALLOWED_ORIGINS=http://localhost:3000

# ── Stripe (required when NODE_ENV=production) ─────────────────────────────
# Server-side only. Use sk_test_... locally and sk_live_... in production.
# Never expose this key to the browser or commit it.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint settings (whsec_...) or `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# ── Supplier handoff ────────────────────────────────────────────────────────
# Protects /api/supplier/orders, /api/supplier/orders.csv and the mark-sent
# action. Required in production; use a long random value, for example:
#   openssl rand -hex 32
ADMIN_TOKEN=

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Set true only when a trusted proxy/load balancer is directly in front of the
# API. It is used for X-Forwarded-For rate-limit keys. Secure cookies are
# detected from X-Forwarded-Proto or a direct TLS socket regardless.
TRUST_PROXY=false
